msgid ""
"Choose how the hourly overtime amount is calculated:\n"
"<ol style=\"padding-left:15px\"><li>Fixed Hourly Rate: A fixed, manually entered hourly rate.</li>\n"
"<li>Salary Component-Based:\n"
"\n"
"(Sum of selected component amounts) ÷ (Payment Days) ÷ (Standard Daily Hours)</li></ol>"
msgstr ""
"Elija cómo se calcula el monto por hora de las horas extras:\n"
"<ol style=\"padding-left:15px\"><li>Tarifa fija por hora: una tarifa por hora fija que se ingresa a mano.</li>\n"
"<li>Según componentes salariales:\n"
"\n"
"(Suma de los montos de los componentes seleccionados) ÷ (Días de pago) ÷ (Horas diarias estándar)</li></ol>"

msgid "'employee_fieldname' must be one of {0}."
msgstr "'employee_fieldname' debe ser uno de {0}."

msgid "A Job Requisition already exists for {0} requested by {1} for the same department.<br> Do you want to continue?"
msgstr "Ya existe una requisición de personal para {0} solicitada por {1} para el mismo departamento.<br> ¿Desea continuar?"

msgid "A bonus, arrear or deduction for one payroll period. See [Additional Salary](https://docs.frappe.io/hr/additional-salary)."
msgstr "Una bonificación, un retroactivo o una deducción para un período de nómina. Vea [Salario adicional](https://docs.frappe.io/hr/additional-salary)."

msgid "A course you run for employees, with its trainer and what it covers. See [Training Program](https://docs.frappe.io/hr/training-program)."
