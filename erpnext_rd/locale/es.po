# ---------------------------------------------------------------------------
# Frappe HR: textos que faltan en su catálogo oficial de español (v16 y develop).
# Se aportan a Frappe HR por Crowdin; cuando lleguen al catálogo oficial, este bloque se puede borrar.
# ---------------------------------------------------------------------------

msgid " Salary slips starting on or after this date will be considered for arrear calculations"
msgstr " Los recibos de nómina con fecha de inicio igual o posterior a esta fecha se tomarán en cuenta para el cálculo de retroactivos"

msgid "'employee_fieldname' must be one of {0}."
msgstr "'employee_fieldname' debe ser uno de {0}."

msgid "<b>Base</b> amount has not been set for the following employee(s): {0}"
msgstr "No se ha definido el monto <b>base</b> para los siguientes empleados: {0}"

msgid ""
"<h3>Help</h3>\n"
"\n"
"<p>Notes:</p>\n"
"\n"
"<ol>\n"
"<li>Use field <code>base</code> for using base salary of the Employee</li>\n"
"<li>Use Salary Component abbreviations in conditions and formulas. <code>BS = Basic Salary</code></li>\n"
"<li>Use field name for employee details in conditions and formulas. <code>Employment Type = employment_type</code><code>Branch = branch</code></li>\n"
"<li>Use field name from Salary Slip in conditions and formulas. <code>Payment Days = payment_days</code><code>Leave without pay = leave_without_pay</code></li>\n"
"<li>Direct Amount can also be entered based on Condition. See example 3</li></ol>\n"
"\n"
"<h4>Examples</h4>\n"
"<ol>\n"
"<li>Calculating Basic Salary based on <code>base</code>\n"
"<pre><code>Condition: base &lt; 10000</code></pre>\n"
"<pre><code>Formula: base * .2</code></pre></li>\n"
"<li>Calculating HRA based on Basic Salary<code>BS</code> \n"
"<pre><code>Condition: BS &gt; 2000</code></pre>\n"
"<pre><code>Formula: BS * .1</code></pre></li>\n"
"<li>Calculating TDS based on Employment Type<code>employment_type</code> \n"
"<pre><code>Condition: employment_type==\"Intern\"</code></pre>\n"
"<pre><code>Amount: 1000</code></pre></li>\n"
"</ol>"
msgstr ""
"<h3>Ayuda</h3>\n"
"\n"
"<p>Notas:</p>\n"
"\n"
"<ol>\n"
"<li>Use el campo <code>base</code> para usar el salario base del empleado</li>\n"
"<li>Use las abreviaturas de los componentes salariales en las condiciones y fórmulas. <code>BS = Basic Salary</code></li>\n"
"<li>Use el nombre del campo para los datos del empleado en las condiciones y fórmulas. <code>Employment Type = employment_type</code><code>Branch = branch</code></li>\n"
"<li>Use el nombre del campo del recibo de nómina en las condiciones y fórmulas. <code>Payment Days = payment_days</code><code>Leave without pay = leave_without_pay</code></li>\n"
"<li>También se puede indicar un monto directo según una condición. Vea el ejemplo 3</li></ol>\n"
"\n"
"<h4>Ejemplos</h4>\n"
"<ol>\n"
"<li>Cálculo del salario básico según <code>base</code>\n"
"<pre><code>Condition: base &lt; 10000</code></pre>\n"
"<pre><code>Formula: base * .2</code></pre></li>\n"
"<li>Cálculo del HRA según el salario básico<code>BS</code> \n"
"<pre><code>Condition: BS &gt; 2000</code></pre>\n"
"<pre><code>Formula: BS * .1</code></pre></li>\n"
"<li>Cálculo del TDS según el tipo de empleo<code>employment_type</code> \n"
"<pre><code>Condition: employment_type==\"Intern\"</code></pre>\n"
"<pre><code>Amount: 1000</code></pre></li>\n"
"</ol>"

msgid ""
"<h4>Condition Examples</h4>\n"
"<ol>\n"
"<li>Applying tax if employee born between 31-12-1937 and 01-01-1958 (Employees aged 60 to 80)<br>\n"
"<code>Condition: date_of_birth&gt;date(1937, 12, 31) and date_of_birth&lt;date(1958, 01, 01)</code></li><br><li>Applying tax by employee gender<br>\n"
"<code>Condition: gender==\"Male\"</code></li><br>\n"
"<li>Applying tax by Salary Component<br>\n"
"<code>Condition: base &gt; 10000</code></li></ol>"
msgstr ""
"<h4>Ejemplos de condiciones</h4>\n"
"<ol>\n"
"<li>Aplicar el impuesto si el empleado nació entre el 31-12-1937 y el 01-01-1958 (empleados de 60 a 80 años)<br>\n"
"<code>Condition: date_of_birth&gt;date(1937, 12, 31) and date_of_birth&lt;date(1958, 01, 01)</code></li><br><li>Aplicar el impuesto según el sexo del empleado<br>\n"
"<code>Condition: gender==\"Male\"</code></li><br>\n"
"<li>Aplicar el impuesto según el componente salarial<br>\n"
"<code>Condition: base &gt; 10000</code></li></ol>"

