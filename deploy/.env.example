# Copiar a deploy/.env y cambiar las contraseñas
ERPNEXT_IMAGE=erpnext-rd
ERPNEXT_IMAGE_TAG=local
SITE_NAME=erp.localhost
ADMIN_PASSWORD=cambiar-admin
DB_ROOT_PASSWORD=cambiar-db-root
HTTP_PUBLISH_PORT=8090
# 127.0.0.1: solo desde esta máquina. 0.0.0.0 para abrirlo en la red local.
HTTP_BIND_ADDRESS=127.0.0.1
# Respaldo diario (hora UTC) y días que se guardan
BACKUP_HORA=07:00
BACKUP_DIAS=7
